# SAP HANA Cloud (structured/relational database)
HANA_HOST=your-hana-host.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=your_db_user
HANA_PASSWORD=your_db_password

# Pinecone (vector database for semantic RAG retrieval)
# Sign up at https://www.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=policy-clauses
PINECONE_ENVIRONMENT=us-east-1-aws

# LangSmith (LLM tracing, prompt versioning, model evaluation)
# Sign up at https://www.langchain.com/langsmith
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=compliance-shadow-prod
LANGSMITH_TRACING_V2=true

# DuckDuckGo Search API
# No login required for basic JSON endpoint — set rate limit config below
DUCKDUCKGO_MAX_RESULTS=10
DUCKDUCKGO_REGION=in-en

# LLM Provider
LLM_API_KEY=your_llm_api_key
LITELLM_BASE_URL=https://your-litellm-gateway.example.com

# GitHub (read-only, for private repository scanning)
GITHUB_TOKEN=ghp_your_readonly_token

# FastAPI
SECRET_KEY=your_jwt_signing_secret_here
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173

# MLflow / DVC (for non-LLM artifact versioning)
MLFLOW_TRACKING_URI=http://localhost:5000
