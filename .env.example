# SAP HANA Cloud
HANA_HOST=your-hana-host.hanacloud.ondemand.com
HANA_PORT=443
HANA_USER=your_db_user
HANA_PASSWORD=your_db_password

# LLM Provider
LLM_API_KEY=your_llm_api_key
LITELLM_BASE_URL=https://your-litellm-gateway.example.com

# GitHub (read-only, for private repository scanning)
GITHUB_TOKEN=ghp_your_readonly_token

# FastAPI
SECRET_KEY=your_jwt_signing_secret_here
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
